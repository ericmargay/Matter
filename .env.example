# Copia a .env para correr el servidor en local con login.
# En producción estas variables se configuran en Railway, nunca en el repo.

# Usuarios del panel. Genera cada línea con: npm run hash-password -- nombre
PANEL_USERS=margay:scrypt$sal$hash,carpio:scrypt$sal$hash

# Firma de las cookies de sesión. Cualquier cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production
